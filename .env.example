# ===== Telegram =====
# Token lấy từ @BotFather (lệnh /newbot)
TELEGRAM_BOT_TOKEN=
# Chat ID của admin (lấy tại @userinfobot). Nhiều admin cách nhau bằng dấu phẩy.
ADMIN_CHAT_ID=

# ===== Webhook (chạy trên Render) =====
# URL public của service, VD: https://nang-tho-telegram-bot.onrender.com
# Để TRỐNG khi chạy local -> bot tự dùng chế độ polling.
WEBHOOK_URL=
# Chuỗi bí mật ngẫu nhiên cho đường dẫn webhook, VD: openssl rand -hex 16
WEBHOOK_SECRET=

# ===== Database =====
# URL Postgres của Neon (dùng chung với n8n). Để TRỐNG -> dùng SQLite file bot.db (chạy local).
DATABASE_URL=

# ===== Facebook =====
FB_PAGE_ID=1367543446440909
# Page Access Token dài hạn (cần quyền read_insights). Xem README mục 3.
FB_PAGE_TOKEN=

# ===== Shopee Affiliate API =====
# Để trống cả 3 nếu chưa có -> bot hiện "chưa kết nối" và dùng số liệu nhập tay (/nhapdon).
SHOPEE_API_BASE_URL=
SHOPEE_APPID=
SHOPEE_SECRET=

# ===== n8n tích hợp =====
# Secret dùng chung cho header X-Webhook-Secret ở /api/pending và /api/heartbeat
N8N_WEBHOOK_SECRET=
# URL n8n sẽ gọi khi admin duyệt/từ chối video (tùy chọn). VD: https://n8n.../webhook/duyet-video
N8N_WEBHOOK_URL=

# ===== Khác =====
PORT=10000
TZ=Asia/Ho_Chi_Minh
